{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Logical reference only; no file opener or URL authority.",
      "properties": {
        "artifact_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "profile_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_sha256",
        "profile_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Trusted pre-production registration; authority, never outputs, owns this set.",
  "properties": {
    "authority_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "namespace_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Namespace Id",
      "type": "string"
    },
    "request_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "required_reference_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxLength": 10000,
      "title": "Required Reference Ids",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "request_id",
    "namespace_id",
    "authority_ref",
    "required_reference_ids"
  ],
  "title": "RequiredEvidenceFrame",
  "type": "object"
}
