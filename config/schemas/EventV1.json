{
  "additionalProperties": false,
  "properties": {
    "action": {
      "const": "unknown",
      "default": "unknown",
      "title": "Action",
      "type": "string"
    },
    "conn_state": {
      "anyOf": [
        {
          "pattern": "^[A-Z0-9]{1,16}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conn State"
    },
    "direction": {
      "default": "unknown",
      "enum": [
        "inbound",
        "outbound",
        "internal",
        "external",
        "unknown"
      ],
      "title": "Direction",
      "type": "string"
    },
    "dst": {
      "format": "ipvanyaddress",
      "title": "Dst",
      "type": "string"
    },
    "dst_port": {
      "anyOf": [
        {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dst Port"
    },
    "duration_us": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Us"
    },
    "icmp_code": {
      "anyOf": [
        {
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Icmp Code"
    },
    "icmp_type": {
      "anyOf": [
        {
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Icmp Type"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "orig_bytes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Orig Bytes"
    },
    "protocol": {
      "enum": [
        "tcp",
        "udp",
        "icmp"
      ],
      "title": "Protocol",
      "type": "string"
    },
    "quality_flags": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
        "type": "string"
      },
      "title": "Quality Flags",
      "type": "array"
    },
    "raw_line_number": {
      "minimum": 1,
      "title": "Raw Line Number",
      "type": "integer"
    },
    "resp_bytes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resp Bytes"
    },
    "row_id": {
      "pattern": "^[0-9a-f]{64}:[1-9][0-9]*$",
      "title": "Row Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "src": {
      "format": "ipvanyaddress",
      "title": "Src",
      "type": "string"
    },
    "src_port": {
      "anyOf": [
        {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Src Port"
    },
    "total_bytes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Bytes"
    },
    "ts_us": {
      "minimum": 0,
      "title": "Ts Us",
      "type": "integer"
    },
    "uid": {
      "anyOf": [
        {
          "pattern": "^C[A-Za-z0-9]{8,24}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uid"
    }
  },
  "required": [
    "input_sha256",
    "raw_line_number",
    "row_id",
    "ts_us",
    "src",
    "dst",
    "protocol"
  ],
  "title": "EventV1",
  "type": "object"
}
