{
  "additionalProperties": false,
  "description": "S8 evidence identity, not the foreign canonical Pointer wire schema.",
  "properties": {
    "row_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Row Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    }
  },
  "required": [
    "source_sha256",
    "row_id"
  ],
  "title": "EvidenceRef",
  "type": "object"
}
